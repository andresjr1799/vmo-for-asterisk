# ── LiveKit ──────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── STT (Deepgram) ───────────────────────────────────
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=es

# ── LLM ──────────────────────────────────────────────
# "openai" or "asap_backend"
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ── ASAP Backend (optional, when LLM_PROVIDER=asap_backend)
ASAP_BACKEND_URL=http://localhost:8000
ASAP_BACKEND_TIMEOUT=45

# ── TTS (ElevenLabs) ─────────────────────────────────
ELEVENLABS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL=eleven_multilingual_v2

# ── Agent ────────────────────────────────────────────
SYSTEM_PROMPT=Eres un asistente virtual amable. Responde en español de forma concisa.
GREETING=Hola, ¿en qué puedo ayudarte?

# ── Observability ────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=vmo-livekit
LOG_LEVEL=INFO
